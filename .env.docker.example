# 배포 설정. 이 파일을 .env 로 복사해 값을 채우세요.
#   cp .env.docker.example .env

# ── 앱을 붙일 경로 ────────────────────────────────────────────────
# 두 값은 반드시 같은 경로를 가리켜야 합니다. BASE_PATH만 끝에 슬래시가 붙습니다.
# BASE_PATH는 번들에 구워지므로 바꾸면 다시 빌드해야 합니다(--build).
BASE_PATH=/godlife/
APP_PATH=/godlife

# ── 1) 이 컨테이너가 도메인을 직접 받는 경우 (권장) ───────────────
# youthvision.co.kr 이 이 서버를 가리키고 80·443이 열려 있을 때.
# Caddy가 Let's Encrypt 인증서를 발급·갱신합니다. -> https://youthvision.co.kr/godlife/
SITE_ADDRESS=youthvision.co.kr
CADDY_TLS=tls you@youthvision.co.kr

# ── 2) 도메인을 이미 다른 웹서버가 받고 있는 경우 ─────────────────
# 앞단(nginx/Apache)이 /godlife/ 를 이 컨테이너로 넘기고 TLS도 앞단이 맡습니다.
# 앞단은 경로를 자르지 말고 /godlife/ 를 그대로 전달해야 합니다 (README 참고).
# SITE_ADDRESS=:80
# CADDY_TLS=
# HTTP_PORT=8080
# HTTPS_PORT=8443

# ── 3) LAN 전용 (공인 도메인 없음) ────────────────────────────────
# Caddy 내부 CA로 인증서를 만듭니다. 접속 기기마다 루트 CA를 신뢰시켜야
# 브라우저 경고가 사라지고 서비스 워커·알림이 동작합니다.
#   docker compose cp web:/data/caddy/pki/authorities/local/root.crt .
# SITE_ADDRESS=church-server.local
# CADDY_TLS=tls internal

# ── 4) 포트포워딩 불가 (Cloudflare Tunnel) ────────────────────────
# docker compose --profile tunnel up -d
# SITE_ADDRESS=:80
# CADDY_TLS=
# CF_TUNNEL_TOKEN=eyJhIjoi...

# ── 선택 ──────────────────────────────────────────────────────────
# Gmail 연동에 쓸 클라이언트 ID. 비워두면 앱 설정 화면에서 직접 등록합니다.
# 승인된 자바스크립트 원본에 https://youthvision.co.kr 을 등록해야 합니다.
VITE_GOOGLE_CLIENT_ID=
