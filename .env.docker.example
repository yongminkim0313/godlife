# church-server 배포 설정. 이 파일을 .env 로 복사해 값을 채우세요.
#   cp .env.docker.example .env

# ── 1) 공인 도메인 + 자동 HTTPS (권장) ─────────────────────────────
# 도메인이 이 서버를 가리키고 공유기에서 80·443을 포워딩한 경우.
# Caddy가 Let's Encrypt 인증서를 발급·갱신합니다.
SITE_ADDRESS=godlife.example.com
CADDY_TLS=tls you@example.com

# ── 2) LAN 전용 (공인 도메인 없음) ────────────────────────────────
# Caddy 내부 CA로 인증서를 만듭니다. 접속 기기마다 루트 CA를 신뢰시켜야
# 브라우저 경고가 사라지고 서비스 워커·알림이 동작합니다.
#   docker compose cp web:/data/caddy/pki/authorities/local/root.crt .
# SITE_ADDRESS=church-server.local
# CADDY_TLS=tls internal

# ── 3) 포트포워딩 불가 (Cloudflare Tunnel) ────────────────────────
# docker compose --profile tunnel up -d
# SITE_ADDRESS=:80
# CADDY_TLS=
# CF_TUNNEL_TOKEN=eyJhIjoi...

# ── 공통 (선택) ───────────────────────────────────────────────────
# 호스트 포트를 바꿔야 할 때만 지정합니다.
# HTTP_PORT=80
# HTTPS_PORT=443

# Gmail 연동을 쓸 경우 빌드에 심을 클라이언트 ID.
# 비워두면 앱 설정 화면에서 직접 등록할 수 있습니다.
VITE_GOOGLE_CLIENT_ID=
