# 하루동행 정적 서빙 + 자동 HTTPS.
#
# TLS 방식은 CADDY_TLS 환경변수 하나로 정한다 (docker-compose.yml -> .env).
#   공인 도메인   CADDY_TLS="tls you@example.com"   Let's Encrypt 자동 발급·갱신
#   LAN 전용     CADDY_TLS="tls internal"          Caddy 내부 CA
#   평문(터널)   CADDY_TLS=""                      + SITE_ADDRESS=":80"
{
	admin off
}

{$SITE_ADDRESS} {
	{$CADDY_TLS}

	root * /srv
	encode zstd gzip

	# 서비스 워커와 진입 문서는 매번 확인해야 새 배포가 사용자에게 전파된다.
	# 여기를 캐시하면 옛 앱이 계속 뜬다.
	@revalidate path /sw.js /index.html / /manifest.webmanifest
	header @revalidate Cache-Control "no-cache, must-revalidate"

	# 파일명에 해시가 붙어 있어 내용이 바뀌면 이름도 바뀐다. 영구 캐시가 안전하다.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 컨테이너 상태 확인용.
	respond /healthz 200

	# 해시 라우터라 서버 라우팅은 필요 없지만, 직접 경로로 들어와도 앱이 뜨게 한다.
	try_files {path} /index.html
	file_server
}
